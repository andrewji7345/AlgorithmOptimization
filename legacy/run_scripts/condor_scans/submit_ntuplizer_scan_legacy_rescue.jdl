universe = vanilla
executable = run_ntuplizer_scan_pt_ak_ca_th.sh

arguments = "$(sample) $(pt) $(ak) $(ca) $(th) $(ak_int) $(ca_int) $(th_int)"

output = logs/job_$(Cluster)_$(Process).out
error  = logs/job_$(Cluster)_$(Process).err
log    = logs/cluster_$(Cluster).log

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_output_files = ""

request_cpus = 1
request_memory = 4GB
request_disk = 10GB
notification = Never

queue sample,pt,ak,ca,th,ak_int,ca_int,th_int from scan_parameters_legacy_rescue.tsv
