universe = vanilla
executable = run_ntuplizer_scan_two_threshold.sh

arguments = "$(sample) $(lower_pt) $(event_pt) $(min_event_jets) $(ak) $(ca) $(th) $(ak_int) $(ca_int) $(th_int)"

output = logs_two_threshold/job_$(Cluster)_$(Process).out
error  = logs_two_threshold/job_$(Cluster)_$(Process).err
log    = logs_two_threshold/cluster_$(Cluster).log

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_output_files = ""

request_cpus = 1
request_memory = 4GB
request_disk = 10GB

# Avoid materializing the entire scan in the scheduler at once.
max_materialize = 1000
max_idle = 250

notification = Never

queue sample,lower_pt,event_pt,min_event_jets,ak,ca,th,ak_int,ca_int,th_int from scan_parameters_two_threshold.tsv
