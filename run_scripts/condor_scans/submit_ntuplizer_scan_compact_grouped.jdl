universe = vanilla

# Running bash explicitly keeps the transferred worker independent of its
# executable mode in source archives.
executable = /bin/bash
transfer_executable = False
transfer_input_files = run_ntuplizer_scan_compact_grouped.sh

arguments = "run_ntuplizer_scan_compact_grouped.sh $(sample) $(ak_radius) $(ak_tag) $(max_events) $(output_name) $(tarball_name)"

output = logs_compact_grouped/job_$(Cluster)_$(Process).out
error  = logs_compact_grouped/job_$(Cluster)_$(Process).err
log    = logs_compact_grouped/cluster_$(Cluster).log

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_output_files = ""
use_x509userproxy = True

request_cpus = 1
request_memory = 4GB
request_disk = 10GB

# Keep a large full scan from flooding the scheduler all at once.
max_materialize = 500
max_idle = 200

notification = Never

queue sample,ak_radius,ak_tag,max_events,output_name,tarball_name from scan_parameters_compact_grouped.tsv
